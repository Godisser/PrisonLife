local function ZVZQEUO_fake_script() -- TextButton_2.LocalScript 
	local script = Instance.new('LocalScript', TextButton_2)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	
	local player = Players.LocalPlayer
	local noclipEnabled = false
	local connection
	
	local button = script.Parent -- This should be the TextButton in your GUI
	
	-- Function to set noclip state
	local function setNoclip(active)
		noclipEnabled = active
	
		if noclipEnabled then
			connection = RunService.RenderStepped:Connect(function()
				if player.Character then
					for _, part in ipairs(player.Character:GetDescendants()) do
						if part:IsA("BasePart") and part.CanCollide then
							part.CanCollide = false
						end
					end
				end
			end)
		else
			if connection then
				connection:Disconnect()
				connection = nil
			end
	
			if player.Character then
				for _, part in ipairs(player.Character:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = true
					end
				end
			end
		end
	
		-- Update button text
		button.Text = noclipEnabled and "Noclip: ON" or "Noclip: OFF"
	end
	
	-- Toggle when button is clicked
	button.MouseButton1Click:Connect(function()
		setNoclip(not noclipEnabled)
	end)
	
	-- Toggle when "R" key is pressed
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not gameProcessed and input.KeyCode == Enum.KeyCode.R then
			setNoclip(not noclipEnabled)
		end
	end)
	
end
coroutine.wrap(ZVZQEUO_fake_script)()
